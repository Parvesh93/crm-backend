# Core
MONGO_URI=
JWT_SECRET=
PORT=5000
CRM_FRONTEND_URL=https://app.ppdesigntech.com

# Email notifications (Hostinger SMTP or another SMTP provider)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PPDT CRM <notifications@yourdomain.com>

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=ppdt_task_notification
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_GRAPH_VERSION=v22.0


# Sales Agent
SALES_AGENT_ENABLED=false
SALES_AGENT_SEARCH_PROVIDER=serper
SERPER_API_KEY=
SALES_AGENT_MARKETS=India,United States,United Kingdom,UAE
SALES_AGENT_SERVICES=Shopify development,custom web development,Next.js development,WordPress development,ecommerce development
SALES_AGENT_MIN_SCORE=65
SALES_AGENT_RESULTS_PER_QUERY=5
SALES_AGENT_MAX_QUERIES=8
SALES_AGENT_DAILY_HOUR=10
SALES_AGENT_TIMEZONE=Asia/Kolkata
SALES_AGENT_AI_MODEL=gpt-4.1-mini
